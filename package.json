{
  "name": "ads-game-ui",
  "version": "1.0.0",
  "private": true,
  "description": "基础游戏 UI：速度表、当前圈数、计时器与开始/重置界面",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "screenshot": "playwright test tests/screenshots",
    "report": "playwright show-report",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "vite": "^5.4.0"
  },
  "generator": {
    "entry": {
      "workOrderType": "skeleton",
      "classifier": {
        "name": "classify_ticket",
        "forceScaffoldOnly": true,
        "lockTicketType": "scaffold",
        "scaffoldOnlyKeywords": [
          "骨架",
          "skeleton",
          "统一入口",
          "目录结构",
          "类型定义"
        ],
        "onScaffoldOnlyKeyword": "set_scaffold_only",
        "residualDirectories": [
          "src/race",
          "src/camera",
          "src/physics",
          "src/player"
        ],
        "onResidualDirectory": "ignore_and_cleanup"
      },
      "deliveryWhitelist": [
        "package.json",
        "tsconfig.json",
        "tsconfig.node.json",
        "vite.config.ts",
        "index.html",
        "src/main.ts",
        "src/types/index.ts",
        "src/utils/index.ts"
      ]
    },
    "generation": {
      "generateCode": {
        "scaffold": {
          "match": "ticket.type == 'scaffold'",
          "handler": "instantiate_scaffold_template",
          "useLlm": false,
          "mode": "deterministic",
          "steps": [
            "checkout_golden_template",
            "variable_replacement",
            "write_files_one_by_one"
          ]
        }
      }
    },
    "scaffoldOnly": {
      "contextInjection": {
        "skipBusinessReferenceImplementation": true,
        "bannedEntries": [
          "types/track",
          "VehiclePhysics",
          "LapTracker"
        ],
        "keepOriginalTicketOnly": true
      },
      "fileTree": {
        "fixedFiles": [
          "src/core/",
          "src/types/index.ts",
          "src/utils/index.ts",
          "src/index.ts",
          "vite.config.ts",
          "tsconfig.json"
        ],
        "template": {
          "content": "export {}",
          "todoComment": true
        }
      },
      "syntaxConstraint": {
        "bannedImports": [
          "import * as THREE",
          "import three"
        ],
        "bannedIdentifiers": [
          "TrackPoint3D",
          "LapResult",
          "VehiclePhysicsConfig",
          "CarInput"
        ]
      }
    },
    "cleanup": {
      "preGeneration": true,
      "restoreEmptyBaseline": true,
      "removeDirectories": [
        "src/camera",
        "src/physics",
        "src/player",
        "src/race"
      ]
    },
    "routing": {
      "skeletonMarkerFiles": [
        "vite.config.ts",
        "index.html",
        "src/main.ts"
      ],
      "onMissingMarkerFile": "full_skeleton_regeneration",
      "forbidDiffOnSemanticMismatch": true
    },
    "base_stages": {
      "development_done": {
        "judge": "exact_path_set_diff",
        "whitelist": [
          "package.json",
          "tsconfig.json",
          "tsconfig.node.json",
          "vite.config.ts",
          "index.html",
          "src/main.ts",
          "src/types/index.ts",
          "src/utils/index.ts"
        ],
        "businessDirectories": [
          "src/camera",
          "src/physics",
          "src/player",
          "src/race"
        ],
        "onBusinessDirectory": "development_failed",
        "reworkChain": {
          "knowledgeBase": "2026-10-15_02",
          "flow": [
            "acceptance_rejected",
            "rework"
          ]
        }
      },
      "development_failed": {
        "knowledgeBase": "2026-10-15_02",
        "trigger": {
          "filesEmptyOrInvalid": true
        },
        "onFilesInvalid": "hard_fail",
        "forbidSamePromptRetry": true,
        "retryPolicy": "switch_to_deterministic_or_abort",
        "flow": [
          "acceptance_rejected",
          "rework"
        ]
      }
    },
    "rework": {
      "requireAcceptanceRejectedReason": true,
      "emptyReasonFallback": "whitelist_diff_defect_report",
      "rejectSignalLessReplay": true
    },
    "skeleton": {
      "mainTs": {
        "imports": [
          "three"
        ],
        "sceneInitPlaceholderOnly": true,
        "bannedBusinessModules": [
          "camera",
          "physics",
          "player",
          "race"
        ]
      }
    },
    "selftest": {
      "scaffoldPassCondition": "byte_identical_to_golden_template_or_contains_nonempty_real_code",
      "rejectEmptyShell": true,
      "emptyShellPatterns": [
        "console.log('xxx loaded')",
        "console.log(\"xxx loaded\")"
      ]
    },
    "validator": {
      "pathWhitelistHardGate": true,
      "onNonWhitelistPath": "fail",
      "whitelist": [
        "package.json",
        "tsconfig.json",
        "tsconfig.node.json",
        "vite.config.ts",
        "index.html",
        "src/main.ts",
        "src/types/index.ts",
        "src/utils/index.ts"
      ],
      "contentSemanticGate": {
        "enabled": true,
        "perFileBannedIdentifiers": [
          "TrackPoint3D",
          "LapResult",
          "VehiclePhysicsConfig",
          "CarInput"
        ],
        "typesIndexCrossFileDuplicateCheck": true
      }
    },
    "contextInjection": {
      "disableBusinessCodeRetrieval": true
    }
  }
}