{
  "name": "ads-game-ui",
  "version": "1.0.0",
  "private": true,
  "description": "基础游戏 UI：速度表、当前圈数、计时器与开始/重置界面",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "screenshot": "playwright test tests/screenshots",
    "report": "playwright show-report",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "vite": "^5.4.0"
  },
  "generator": {
    "entry": {
      "workOrderType": "skeleton",
      "deliveryWhitelist": [
        "package.json",
        "tsconfig.json",
        "tsconfig.node.json",
        "vite.config.ts",
        "index.html",
        "src/main.ts",
        "src/types/index.ts",
        "src/utils/index.ts"
      ]
    },
    "base_stages": {
      "development_done": {
        "judge": "exact_path_set_diff",
        "whitelist": [
          "package.json",
          "tsconfig.json",
          "tsconfig.node.json",
          "vite.config.ts",
          "index.html",
          "src/main.ts",
          "src/types/index.ts",
          "src/utils/index.ts"
        ],
        "businessDirectories": [
          "src/camera",
          "src/physics",
          "src/player",
          "src/race"
        ],
        "onBusinessDirectory": "development_failed",
        "reworkChain": {
          "knowledgeBase": "2026-10-15_02",
          "flow": [
            "acceptance_rejected",
            "rework"
          ]
        }
      }
    },
    "rework": {
      "requireAcceptanceRejectedReason": true,
      "emptyReasonFallback": "whitelist_diff_defect_report",
      "rejectSignalLessReplay": true
    },
    "skeleton": {
      "mainTs": {
        "imports": [
          "three"
        ],
        "sceneInitPlaceholderOnly": true,
        "bannedBusinessModules": [
          "camera",
          "physics",
          "player",
          "race"
        ]
      }
    },
    "contextInjection": {
      "disableBusinessCodeRetrieval": true
    }
  }
}